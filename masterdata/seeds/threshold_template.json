[
  {
    "code": "TT_COMPUTE_IDLE",
    "display_name": "Idle Compute Instance Detection",
    "description": "Flags compute instances running with average CPU utilization below 5% for 7 consecutive days.",
    "sort_order": 1,
    "parent_code": null,
    "attributes": {
      "target_monitoring_type": "COMPUTE_HOST",
      "metric_code": "cpu_utilization_percentage",
      "operator": "LESS_THAN",
      "threshold_value": 5.0,
      "evaluation_window_days": 7,
      "default_severity": "WARNING"
    }
  },
  {
    "code": "TT_STORAGE_UNATTACHED",
    "display_name": "Unattached Persistent Storage Cleanup",
    "description": "Detects unattached block storage volumes and idle disks detached for more than 14 days.",
    "sort_order": 2,
    "parent_code": null,
    "attributes": {
      "target_monitoring_type": "STORAGE_STORE",
      "metric_code": "storage_allocated_bytes",
      "operator": "GREATER_THAN",
      "threshold_value": 0.0,
      "unattached_duration_days": 14,
      "default_severity": "MEDIUM"
    }
  },
  {
