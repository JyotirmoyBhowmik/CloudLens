# ==============================================================================
# CloudLens Platform - Environment Configuration Template (.env.example)
#
# Copy this file to .env and adjust values for your local development environment.
# DO NOT COMMIT REAL SECRETS. .env is excluded via .gitignore.
# ==============================================================================

# Core Platform Environment
CLOUDLENS_ENV=development
CLOUDLENS_REQUIRE_REALDB=1
CLOUDLENS_DOMAIN=localhost
CLOUDLENS_GATE_MODE=permissive
CLOUDLENS_VERSION=0.1.0
CLOUDLENS_COMMIT=dev

# Database Persistence (PostgreSQL 16)
DATABASE_URL=postgresql://cloudlens:cloudlens_dev_password@localhost:5432/cloudlens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cloudlens
POSTGRES_USER=cloudlens
POSTGRES_PASSWORD=cloudlens_dev_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Distributed Cache & Task Queue (Valkey / Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Secret Store (OpenBao / HashiCorp Vault)
SECRET_STORE_BACKEND=vault
VAULT_ADDR=http://localhost:8200
VAULT_AUTH=token
VAULT_TOKEN=dev-vault-token-cloudlens
VAULT_DEV_ROOT_TOKEN_ID=dev-vault-token-cloudlens

# Identity & Access Management (Keycloak OIDC)
OIDC_ISSUER=http://localhost:8081/realms/cloudlens
OIDC_CLIENT_ID=cloudlens-api
OIDC_AUDIENCE=cloudlens-api
OIDC_CLIENT_SECRET=dev-client-secret
OIDC_JWKS_URI=http://localhost:8081/realms/cloudlens/protocol/openid-connect/certs

# CORS Ingress Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Email Notifications (SMTP / Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SENDER=alerts@cloudlens.internal
CLOUDLENS_ALERT_EMAIL_SENDER=alerts@cloudlens.internal

# S3-Compatible Object Storage (MinIO)
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=cloudlens-data
OBJECT_STORE_ACCESS_KEY=cloudlens_minio
OBJECT_STORE_SECRET_KEY=cloudlens_minio_password
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_USE_SSL=false

# Observability & Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
TEMPO_ENDPOINT=http://localhost:3200
