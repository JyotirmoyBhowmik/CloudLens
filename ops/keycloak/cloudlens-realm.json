{
  "id": "cloudlens",
  "realm": "cloudlens",
  "enabled": true,
  "displayName": "CloudLens Enterprise Platform",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "SUPER_ADMIN",
        "description": "Enterprise Super Administrator"
      },
      {
        "name": "PLATFORM_ADMIN",
        "description": "Platform Operations Administrator"
      },
      {
        "name": "CLOUD_ADMINISTRATOR",
        "description": "Cloud Infrastructure Administrator"
      },
      {
        "name": "FINOPS_ADMINISTRATOR",
        "description": "FinOps Financial Governance Lead"
      },
      {
        "name": "FINANCE_USER",
        "description": "Financial Analyst and Budget Planner"
      },
      {
        "name": "IT_OPERATIONS_USER",
        "description": "IT Operations and Infrastructure Engineer"
      },
      {
        "name": "APPLICATION_OWNER",
        "description": "Service and Application Owner"
      },
      {
        "name": "READ_ONLY_USER",
        "description": "Read-Only Stakeholder and Observer"
      },
      {
        "name": "AUDITOR",
        "description": "Security, Compliance and Audit Inspector"
      }
    ]
  },
  "clients": [
    {
      "clientId": "grafana",
      "name": "Grafana Observability Portal",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "grafana-client-secret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3001/*",
        "http://localhost:3000/*",
        "http://grafana:3000/*"
      ],
      "defaultClientScopes": [
        "web-origins",
        "role_list",
        "profile",
        "roles",
        "email"
      ]
    },
    {
      "clientId": "cloudlens-api",
      "name": "CloudLens Platform API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-client-secret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:8000/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:8000/*",
        "http://127.0.0.1:4173/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "+"
      ],
      "defaultClientScopes": [
        "web-origins",
        "role_list",
        "profile",
        "roles",
        "email"
      ]
    }
  ],
